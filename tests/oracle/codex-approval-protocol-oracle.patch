@@ -0,0 +1,23 @@
+use codex_app_server_protocol::{ApprovalsReviewer, AskForApproval, CommandExecutionApprovalDecision, FileChangeRequestApprovalParams};
+use codex_protocol::approvals::{ExecPolicyAmendment, NetworkPolicyAmendment, NetworkPolicyRuleAction};
+use codex_protocol::protocol::ReviewDecision;
+use serde_json::{json, Value};
+
+fn parse_result<T: serde::de::DeserializeOwned + serde::Serialize>(value: Value) -> Value {
+    match serde_json::from_value::<T>(value) { Ok(value) => json!({"ok":value}), Err(error) => json!({"error":error.to_string()}) }
+}
+#[test]
+fn export_approval_protocol_v2_oracle() -> Result<(), Box<dyn std::error::Error>> {
+    let asks = vec![json!("on-request"),json!("on-failure"),json!({"granular":{"sandbox_approval":true,"rules":false,"mcp_elicitations":true}}),json!({"granular":{"rules":false,"mcp_elicitations":true}})]
+        .into_iter().map(|input|json!({"input":input,"result":parse_result::<AskForApproval>(input.clone())})).collect::<Vec<_>>();
+    let reviewers = ["user","auto_review","guardian_subagent","bad"].into_iter().map(|input|json!({"input":input,"result":parse_result::<ApprovalsReviewer>(json!(input))})).collect::<Vec<_>>();
+    let core = vec![ReviewDecision::Approved,ReviewDecision::ApprovedForSession,ReviewDecision::ApprovedMcpPolicyAmendment,ReviewDecision::TimedOut,ReviewDecision::denied("x"),ReviewDecision::Abort,ReviewDecision::ApprovedExecpolicyAmendment{proposed_execpolicy_amendment:ExecPolicyAmendment::new(vec!["git".into()])},ReviewDecision::NetworkPolicyAmendment{network_policy_amendment:NetworkPolicyAmendment{host:"example.test".into(),action:NetworkPolicyRuleAction::Allow}}];
+    let mapped = core.into_iter().map(|input| { let output=CommandExecutionApprovalDecision::from(input.clone()); json!({"core":input,"v2":output}) }).collect::<Vec<_>>();
+    let file_change = vec![
+        json!({"threadId":"thread","turnId":"turn","itemId":"item","startedAtMs":17,"reason":null,"grantRoot":null}),
+        json!({"threadId":"thread","turnId":"turn","itemId":"item","startedAtMs":17}),
+    ].into_iter().map(|input|json!({"input":input,"result":parse_result::<FileChangeRequestApprovalParams>(input.clone())})).collect::<Vec<_>>();
+    let output=json!({"upstream":"9f97cb79eb15b38d24c552c56fe24e211ff9cf3a","askForApproval":asks,"reviewer":reviewers,"reviewDecisionMapping":mapped,"fileChange":file_change});
+    std::fs::write(std::env::var("CODEX_APPROVAL_PROTOCOL_V2_ORACLE_OUTPUT")?,serde_json::to_vec_pretty(&output)?)?;
+    Ok(())
+}
