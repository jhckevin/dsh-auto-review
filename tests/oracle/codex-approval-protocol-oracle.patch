+#[test]
+fn export_approval_store_and_route_oracle() -> Result<(), Box<dyn std::error::Error>> {
+    use codex_protocol::config_types::ApprovalsReviewer;
+    let a = serde_json::json!({"path":"a"});
+    let b = serde_json::json!({"path":"b"});
+    let mut store = ApprovalStore::default();
+    let empty = [store.get(&a), store.get(&b)];
+    store.put(a.clone(), ReviewDecision::ApprovedForSession);
+    let partial = [store.get(&a), store.get(&b)];
+    store.put(b.clone(), ReviewDecision::ApprovedForSession);
+    let all = [store.get(&a), store.get(&b)];
+    store.put(b.clone(), ReviewDecision::Approved);
+    let non_session = [store.get(&a), store.get(&b)];
+    let granular = AskForApproval::Granular(GranularApprovalConfig {
+        sandbox_approval: true, rules: true, skill_approval: false,
+        request_permissions: false, mcp_elicitations: true,
+    });
+    let policies = [
+        ("untrusted", AskForApproval::UnlessTrusted),
+        ("on-request", AskForApproval::OnRequest),
+        ("granular", granular),
+        ("never", AskForApproval::Never),
+    ];
+    let reviewers = [("user", ApprovalsReviewer::User), ("auto_review", ApprovalsReviewer::AutoReview)];
+    let route = policies.into_iter().flat_map(|(policy_name, policy)| {
+        reviewers.into_iter().map(move |(reviewer_name, reviewer)| serde_json::json!({
+            "policy":policy_name,"reviewer":reviewer_name,
+            "guardian":crate::guardian::routes_approval_policy_to_guardian(policy,reviewer)
+        }))
+    }).collect::<Vec<_>>();
+    let output = serde_json::json!({
+        "upstream":"9f97cb79eb15b38d24c552c56fe24e211ff9cf3a",
+        "store":{"empty":empty,"partial":partial,"all":all,"nonSession":non_session},
+        "route":route
+    });
+    std::fs::write(std::env::var("CODEX_APPROVAL_STORE_ORACLE_OUTPUT")?,serde_json::to_vec_pretty(&output)?)?;
+    Ok(())
+}
diff --git a/codex-rs/hooks/src/events/permission_request.rs b/codex-rs/hooks/src/events/permission_request.rs
index d2487494b..333333333 100644
--- a/codex-rs/hooks/src/events/permission_request.rs
+++ b/codex-rs/hooks/src/events/permission_request.rs
@@ -335,3 +335,46 @@ mod tests {
         assert_eq!(resolve_permission_request_decision(decisions.iter()), None);
     }
+
+    fn decision_json(value: Option<PermissionRequestDecision>) -> serde_json::Value {
+        match value {
+            None => serde_json::Value::Null,
+            Some(PermissionRequestDecision::Allow) => serde_json::json!({"allow":true}),
+            Some(PermissionRequestDecision::Deny { message }) => serde_json::json!({"deny":message}),
+        }
+    }
+
+    #[test]
+    fn export_permission_request_protocol_oracle() -> Result<(), Box<dyn std::error::Error>> {
+        let parser_inputs = [
+            "", "plain text", "{",
+            r#"{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"allow"}}}"#,
+            r#"{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"deny","message":"blocked"}}}"#,
+            r#"{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"allow","updatedInput":{}}}}"#,
+        ];
+        let parser = parser_inputs.into_iter().map(|input| {
+            let parsed = crate::engine::output_parser::parse_permission_request(input);
+            let result = parsed.map(|output| serde_json::json!({
+                "decision": match output.decision {
+                    None => serde_json::Value::Null,
+                    Some(crate::engine::output_parser::PermissionRequestDecision::Allow) => serde_json::json!({"allow":true}),
+                    Some(crate::engine::output_parser::PermissionRequestDecision::Deny { message }) => serde_json::json!({"deny":message}),
+                },
+                "invalidReason": output.invalid_reason,
+            }));
+            serde_json::json!({"input":input,"result":result})
+        }).collect::<Vec<_>>();
+        let allow = PermissionRequestDecision::Allow;
+        let deny_a = PermissionRequestDecision::Deny { message: "first deny".into() };
+        let deny_b = PermissionRequestDecision::Deny { message: "second deny".into() };
+        let empty = Vec::<PermissionRequestDecision>::new();
+        let fold = serde_json::json!({
+            "empty": decision_json(resolve_permission_request_decision(empty.iter())),
+            "allow": decision_json(resolve_permission_request_decision([&allow])),
+            "allowThenDeny": decision_json(resolve_permission_request_decision([&allow,&deny_a])),
+            "firstDenyWins": decision_json(resolve_permission_request_decision([&deny_a,&deny_b])),
+        });
+        let output = serde_json::json!({"upstream":"9f97cb79eb15b38d24c552c56fe24e211ff9cf3a","parser":parser,"fold":fold});
+        std::fs::write(std::env::var("CODEX_PERMISSION_REQUEST_ORACLE_OUTPUT")?,serde_json::to_vec_pretty(&output)?)?;
+        Ok(())
+    }
 }
diff --git a/codex-rs/app-server-protocol/tests/approval_protocol_v2_oracle.rs b/codex-rs/app-server-protocol/tests/approval_protocol_v2_oracle.rs
