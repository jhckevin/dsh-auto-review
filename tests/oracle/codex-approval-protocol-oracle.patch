@@ -0,0 +1,79 @@
+use codex_protocol::approvals::{ExecApprovalRequestEvent, ExecPolicyAmendment, NetworkApprovalContext, NetworkPolicyAmendment, NetworkPolicyRuleAction};
+use codex_protocol::config_types::ApprovalsReviewer;
+use codex_protocol::protocol::{AskForApproval, FileChange, ReviewDecision};
+use serde_json::{json, Value};
+
+fn parse_result<T: serde::de::DeserializeOwned + serde::Serialize>(value: Value) -> Value {
+    match serde_json::from_value::<T>(value) {
+        Ok(value) => json!({"ok": serde_json::to_value(value).unwrap()}),
+        Err(error) => json!({"error": error.to_string()}),
+    }
+}
+
+#[test]
+fn export_approval_protocol_oracle() -> Result<(), Box<dyn std::error::Error>> {
+    let reviewer = ["user", "auto_review", "guardian_subagent", "bad"]
+        .into_iter().map(|input| json!({"input": input, "result": parse_result::<ApprovalsReviewer>(json!(input))})).collect::<Vec<_>>();
+    let ask_inputs = vec![
+        json!("untrusted"), json!("on-request"), json!("on-failure"), json!("never"),
+        json!({"granular":{"sandbox_approval":true,"rules":false,"mcp_elicitations":true}}),
+        json!({"granular":{"sandbox_approval":true,"rules":false,"skill_approval":true,"request_permissions":true,"mcp_elicitations":true}}),
+        json!({"granular":{"sandbox_approval":true,"rules":false}}),
+        json!({"granular":{"skill_approval":true,"request_permissions":true,"mcp_elicitations":true}}),
+    ];
+    let ask = ask_inputs.into_iter().map(|input| json!({"input":input,"result":parse_result::<AskForApproval>(input.clone())})).collect::<Vec<_>>();
+    let decisions = vec![
+        ReviewDecision::Approved,
+        ReviewDecision::ApprovedExecpolicyAmendment { proposed_execpolicy_amendment: ExecPolicyAmendment::new(vec!["git".into(), "status".into()]) },
+        ReviewDecision::ApprovedForSession,
+        ReviewDecision::ApprovedMcpPolicyAmendment,
+        ReviewDecision::NetworkPolicyAmendment { network_policy_amendment: NetworkPolicyAmendment { host: "example.test".into(), action: NetworkPolicyRuleAction::Allow } },
+        ReviewDecision::denied("opaque rejection"), ReviewDecision::TimedOut, ReviewDecision::Abort,
+    ];
+    let decision_json = decisions.iter().map(|value| json!({"json":value,"opaque":value.to_opaque_string()})).collect::<Vec<_>>();
+    let minimal = json!({"call_id":"call","started_at_ms":17,"command":["echo","hi"],"cwd":"/work","parsed_cmd":[]});
+    let minimal_event: ExecApprovalRequestEvent = serde_json::from_value(minimal.clone())?;
+    let explicit_empty: ExecApprovalRequestEvent = serde_json::from_value(json!({"call_id":"call","turn_id":"turn","started_at_ms":18,"command":["echo"],"cwd":"/work","parsed_cmd":[],"available_decisions":[]}))?;
+    let network_context = NetworkApprovalContext { host: "example.test".into(), protocol: codex_protocol::approvals::NetworkApprovalProtocol::Https };
+    let allow = NetworkPolicyAmendment { host: "example.test".into(), action: NetworkPolicyRuleAction::Allow };
+    let deny = NetworkPolicyAmendment { host: "example.test".into(), action: NetworkPolicyRuleAction::Deny };
+    let exec = json!({
+        "kindDefault": serde_json::to_value(&minimal_event)?,
+        "effectiveId": minimal_event.effective_approval_id(),
+        "explicitEmpty": explicit_empty.effective_available_decisions(),
+        "defaults": {
+            "ordinary": ExecApprovalRequestEvent::default_available_decisions(None,None,None,None),
+            "execAmendment": ExecApprovalRequestEvent::default_available_decisions(None,Some(&ExecPolicyAmendment::new(vec!["git".into()])),None,None),
+            "network": ExecApprovalRequestEvent::default_available_decisions(Some(&network_context),None,Some(&[deny.clone(),allow.clone()]),None),
+            "networkDenyOnly": ExecApprovalRequestEvent::default_available_decisions(Some(&network_context),None,Some(&[deny]),None),
+            "additionalPermissions": ExecApprovalRequestEvent::default_available_decisions(None,None,None,Some(&Default::default()))
+        },
+        "environmentAlias": parse_result::<ExecApprovalRequestEvent>(json!({"call_id":"call","environment_id":"local","started_at_ms":19,"command":[],"cwd":"/work","parsed_cmd":[]})),
+        "unsafeTime": parse_result::<ExecApprovalRequestEvent>(json!({"call_id":"call","started_at_ms":9223372036854775808u64,"command":[],"cwd":"/work","parsed_cmd":[]}))
+    });
+    let apply = vec![
+        json!({"call_id":"patch","started_at_ms":20,"changes":{}}),
+        json!({"call_id":"patch","turn_id":"turn","started_at_ms":21,"changes":{"/tmp/a":{"type":"update","unified_diff":"@@","move_path":null}},"reason":null,"grant_root":null}),
+    ].into_iter().map(|input| json!({"input":input,"result":parse_result::<codex_protocol::approvals::ApplyPatchApprovalRequestEvent>(input.clone())})).collect::<Vec<_>>();
+    let file_change_inputs = vec![
+        json!({"type":"add","content":"new"}),
+        json!({"type":"delete","content":"old"}),
+        json!({"type":"update","unified_diff":"@@","move_path":null}),
+        json!({"type":"update","unified_diff":"@@","move_path":"/tmp/moved"}),
+        json!({"Add":{"content":"external"}}),
+        json!({"content":"missing type"}),
+        json!({"type":"unknown","content":"x"}),
+        Value::Null,
+        json!({"type":"add"}),
+        json!({"type":"update","unified_diff":"@@"}),
+        json!({"type":"add","content":"new","extra":true}),
+    ];
+    let file_changes = file_change_inputs.into_iter().map(|input| json!({"input":input,"result":parse_result::<FileChange>(input.clone())})).collect::<Vec<_>>();
+    let output = json!({
+        "upstream":"9f97cb79eb15b38d24c552c56fe24e211ff9cf3a",
+        "defaults":{"askForApproval":AskForApproval::default(),"approvalsReviewer":ApprovalsReviewer::default(),"reviewDecision":ReviewDecision::default()},
+        "reviewer":reviewer,"askForApproval":ask,"reviewDecisions":decision_json,"exec":exec,"fileChange":file_changes,"applyPatch":apply
+    });
+    std::fs::write(std::env::var("CODEX_APPROVAL_PROTOCOL_ORACLE_OUTPUT")?, serde_json::to_vec_pretty(&output)?)?;
+    Ok(())
+}
