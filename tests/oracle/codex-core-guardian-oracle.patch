+    };
+    let network = GuardianApprovalRequest::NetworkAccess {
+        id: "path-network".into(), turn_id: "path-turn".into(), target: "example.test:443".into(),
+        host: "example.test".into(), protocol: NetworkApprovalProtocol::Https, port: 443,
+        trigger: Some(GuardianNetworkAccessTrigger {
+            call_id: "path-call".into(), tool_name: "exec_command".into(), command: vec!["curl".into()],
+            cwd: ordinary_non_utf.clone(), sandbox_permissions: SandboxPermissions::UseDefault,
