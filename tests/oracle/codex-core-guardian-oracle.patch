+fn path_uri_oracle() -> Value {
+    let left = PathUri::parse("file:///C:/Repo/%41%FF").unwrap();
+    let right = PathUri::parse("file:///c:/repo/a%FF").unwrap();
+    let encoded_separator = PathUri::parse("file:///C:/Repo/a%5Cb").unwrap();
+    let slash = PathUri::parse("file:///c:/repo/a/b").unwrap();
+    let cache_action = ApprovalAction::ExecCommand {
+        id: "path-cache".into(), environment_id: "remote".into(), command: vec!["pwd".into()],
+        hook_command: "pwd".into(), cwd: left.clone(), sandbox_permissions: SandboxPermissions::UseDefault,
+        additional_permissions: None, justification: None, tty: false, proposed_execpolicy_amendment: None,
+    };
+
+    let opaque_bytes = vec![b'/', b't', b'm', b'p', b'/', 0xff, 0, b'x'];
+    let opaque_path = AbsolutePathBuf::try_from(PathBuf::from(std::ffi::OsString::from_vec(opaque_bytes.clone()))).unwrap();
+    let opaque_uri = PathUri::from_abs_path(&opaque_path);
+    let recovered_opaque = opaque_uri.to_abs_path().unwrap();
+    let ordinary_non_utf = PathUri::parse("file:///tmp/non-utf8-%FF").unwrap();
+    let recovered_ordinary = ordinary_non_utf.to_abs_path().unwrap();
+    let valid_utf8_fallback = PathUri::parse("file:///%00/bad/path/L3RtcC9h").unwrap();
+    let valid_posix_drive_fallback = PathUri::parse("file:///%00/bad/path/L0M6L3dvcmtzcGFjZQ").unwrap();
+    let recovered_posix_drive = valid_posix_drive_fallback.to_abs_path().unwrap();
+    let forged_non_utf_fallback = PathUri::parse("file:///%00/bad/path/L3RtcC__").unwrap();
+    let valid_permission_profile = AdditionalPermissionProfile {
+        network: None,
+        file_system: Some(FileSystemPermissions {
+            entries: vec![FileSystemSandboxEntry {
+                path: FileSystemPath::Path { path: valid_posix_drive_fallback.clone() },
+                access: FileSystemAccessMode::Read,
