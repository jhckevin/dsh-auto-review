+fn partial_permission_profiles_oracle() -> Value {
+    let inputs = [
+        ("legacy_empty", json!({"file_system":{"read":[],"write":[]}})),
+        ("legacy_paths", json!({"file_system":{"read":["/work/read"],"write":["/work/write"]}})),
+        ("canonical_native_collapses", json!({"file_system":{"entries":[
+            {"path":{"type":"path","path":"/work/read"},"access":"read"},
+            {"path":{"type":"path","path":"/work/write"},"access":"write"}
+        ]}})),
+        ("canonical_glob_deny_missing_depth", json!({"file_system":{
+            "entries":[
+                {"path":{"type":"glob_pattern","pattern":"**/.env"},"access":"deny","missing_path_behavior":"skip"},
+                {"path":{"type":"special","value":{"kind":"unknown","path":":future","subpath":"x"}},"access":"read"}
+            ],"glob_scan_max_depth":4
+        }})),
+        ("canonical_project_roots", json!({"file_system":{
+            "entries":[{"path":{"type":"special","value":{"kind":"project_roots","subpath":"docs"}},"access":"write"}]
+        }})),
+        ("canonical_windows_path", json!({"file_system":{
+            "entries":[{"path":{"type":"path","path":"C:\\Repo\\A"},"access":"deny"}],
+            "glob_scan_max_depth":1
+        }})),
+    ];
+    let fixtures = inputs.into_iter().map(|(name, input)| {
+        let parsed: AdditionalPermissionProfile = serde_json::from_value(input.clone()).unwrap();
+        json!({"name":name,"input":input,"json":serde_json::to_value(parsed).unwrap()})
+    }).collect::<Vec<_>>();
+
+    let non_utf = PathUri::parse("file:///tmp/non-utf8-%FF").unwrap();
+    let non_utf_profile = AdditionalPermissionProfile {
+        network: None,
+        file_system: Some(FileSystemPermissions {
+            entries: vec![FileSystemSandboxEntry {
+                path: FileSystemPath::Path { path: non_utf },
+                access: FileSystemAccessMode::Deny,
+                missing_path_behavior: None,
+            }],
+            glob_scan_max_depth: NonZeroUsize::new(1),
+        }),
+    };
+    let error = serde_json::to_value(non_utf_profile).unwrap_err().to_string();
+    json!({
+        "fixtures": fixtures,
+        "serializationErrors": [{"name":"canonical_non_utf8_path","error":error}],
+    })
+}
