+fn oracle_entry(name: &str, request: GuardianApprovalRequest) -> serde_json::Result<Value> {
+    let formatted = format_guardian_action_pretty(&request)?;
+    Ok(json!({
+        "name": name,
+        "json": guardian_approval_request_to_json(&request)?,
+        "assessment": guardian_assessment_action(&request),
+        "reviewed": guardian_reviewed_action(&request),
+        "formatted": { "text": formatted.text, "truncated": formatted.truncated },
+    }))
+}
