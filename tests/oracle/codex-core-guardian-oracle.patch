+    let valid_opaque_cwd_json = guardian_approval_request_to_json(&valid_opaque_cwd.into_guardian_request().unwrap()).unwrap();
+    let forged_opaque_cwd_json = guardian_approval_request_to_json(&forged_opaque_cwd.into_guardian_request().unwrap()).unwrap();
+    let valid_utf8_fallback_cwd_json = guardian_approval_request_to_json(&valid_utf8_fallback_cwd.into_guardian_request().unwrap()).unwrap();
+    let write_stdin = GuardianApprovalRequest::WriteStdin {
+        id: "path-write".into(), approval_id: "path-approval".into(), environment_id: "local".into(),
+        process_id: 9, input: String::new(), cwd: ordinary_non_utf.clone(), tty: false,
