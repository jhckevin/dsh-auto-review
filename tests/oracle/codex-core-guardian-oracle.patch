+    };
+    let forged_permission_profile = AdditionalPermissionProfile {
+        network: None,
+        file_system: Some(FileSystemPermissions {
+            entries: vec![FileSystemSandboxEntry {
+                path: FileSystemPath::Path { path: forged_non_utf_fallback.clone() },
+                access: FileSystemAccessMode::Read,
