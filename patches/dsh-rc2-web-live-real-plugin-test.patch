index 00000000..7320fe80
--- /dev/null
+++ b/apps/cli/tests/auto-review-hot-install.smoke.mjs
@@ -0,0 +1,74 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtempSync,mkdirSync,writeFileSync,readFileSync,existsSync,symlinkSync,readdirSync,realpathSync} from 'node:fs';
+import {createRequire} from 'node:module';
+import {resolve,join} from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {spawn,execFileSync,spawnSync} from 'node:child_process';
+const repo=fileURLToPath(new URL('../../../',import.meta.url));
+const bin=join(repo,'.live-cli-build/apps/cli/src/bin.js');
+const tsx=fileURLToPath(import.meta.resolve('tsx/esm'));
+async function until(check,ms=30000){const end=Date.now()+ms;while(!check()){if(Date.now()>end)throw Error('timed out');await new Promise(r=>setTimeout(r,25));}}
+test('real AutoReview release bundle installs into running web with native defaults unchanged',{timeout:700000},async()=>{
+  const input=process.env.DSH_LIVE_RELEASE_DIR,bridge=process.env.DSH_LIVE_BRIDGE_DIR,parent=process.env.DSH_LIVE_EVIDENCE_PARENT;
+  assert.ok(input&&bridge&&parent,'Provide release/bridge/evidence directories');
+  const files=[...readdirSync(input).filter(n=>n.endsWith('.tgz')).map(n=>join(input,n)),...readdirSync(bridge).filter(n=>n.endsWith('.tgz')).map(n=>join(bridge,n))];
+  const packages=files.map(path=>({path,pkg:JSON.parse(execFileSync('tar',['-xOf',path,'package/package.json'],{encoding:'utf8'}))}));
+  const plugin=packages.find(p=>p.pkg.name==='@jhckevin/dsh-auto-review');assert.ok(plugin);assert.equal(plugin.pkg.version,'0.5.6-rc.2');
+  const dir=mkdtempSync(join(parent,'real-auto-review-')),home=join(dir,'home'),profile=join(home,'profiles/web');
+  mkdirSync(profile,{recursive:true});const peers=join(dir,'node_modules/@deepseek-ai');mkdirSync(peers,{recursive:true});
+  const require=createRequire(join(repo,'apps/cli/package.json'));
+  for(const bundle of ['@deepseek-ai/dsh-base','@deepseek-ai/dsh-web-app']){
+    const scope=resolve(realpathSync(require.resolve(`${bundle}/package.json`)),'../../..','@deepseek-ai');
+    for(const name of readdirSync(scope)){const dest=join(peers,name);if(!existsSync(dest))symlinkSync(realpathSync(join(scope,name)),dest,'dir');}
+  }
+  const overrides=Object.fromEntries(packages.map(p=>[p.pkg.name,`file:${p.path}`]));
+  // Bundle roots do not expose every transitive peer (e.g. dsh-settings).
+  // Link actual installed peers, never synthetic implementations or new versions.
+  const owners=readdirSync(peers).map(name=>createRequire(realpathSync(join(peers,name,'package.json'))));
+  const peerEvidence={};
+  for(const [name,range] of Object.entries(plugin.pkg.peerDependencies)){
+    const dest=join(dir,'node_modules',name);if(existsSync(dest))continue;
+    const candidates=new Set();
+    for(const owner of owners){try{const path=realpathSync(owner.resolve(`${name}/package.json`));const version=JSON.parse(readFileSync(path,'utf8')).version;if(range==='0.1.1-rc.2'&&version!==range)continue;candidates.add(path);}catch{}}
+    assert.equal(candidates.size,1,`missing or ambiguous existing host peer ${name}`);
+    const found=[...candidates][0];peerEvidence[name]=found;mkdirSync(resolve(dest,'..'),{recursive:true});symlinkSync(resolve(found,'..'),dest,'dir');
+  }
+  writeFileSync(join(dir,'peer-identities.json'),JSON.stringify(peerEvidence,null,2));
+  writeFileSync(join(profile,'package.json'),JSON.stringify({name:'private-ar-hot-install',private:true,packageManager:'pnpm@11.7.0',pnpm:{overrides},dsh:{profile:{bundles:['@deepseek-ai/dsh-base','@deepseek-ai/dsh-web-app']}}}));
+  writeFileSync(join(profile,'pnpm-workspace.yaml'),JSON.stringify({autoInstallPeers:false,overrides}));
+  const report=join(dir,'registration.json'),observer=join(dir,'observer.mjs');
+  writeFileSync(observer,`import {writeFileSync,appendFileSync} from 'node:fs';
+export const inject=['loader'];
+export function apply(ctx){ctx.on('hmr/config-update-failed',(file,error)=>appendFileSync(${JSON.stringify(join(dir,'hmr-errors.log'))},file+' '+String(error.stack??error)+'\\n'));const timer=setInterval(()=>{writeFileSync(${JSON.stringify(join(dir,'diagnostic.json'))},JSON.stringify({services:['actionReview','actionReviewSettings','settings','agents','tools','systemPrompt','sandboxPolicy'].map(k=>[k,!!ctx.get(k)]),rows:Array.from(ctx.loader.entries()).filter(e=>e.options.id?.startsWith('auto-review')).map(e=>({id:e.options.id,status:e.fiber?.status,error:String(e.error??'')}))}));},250);ctx.effect(()=>()=>clearInterval(timer));ctx.inject(['actionReview','actionReviewSettings'],async c=>{
+try{const service=c.actionReviewSettings;const before=service.read();
+const after=await service.update({patch:{sandboxDefaultAllow:!before.value.sandboxDefaultAllow},expectedRevision:before.revision});
+const effective=c.actionReview.uiSettings();
+const rows=Array.from(c.loader.entries()).filter(e=>e.options.id?.startsWith('auto-review')).map(e=>({id:e.options.id,name:e.options.name,protocol:e.options.config?.approvalProtocol}));
+writeFileSync(${JSON.stringify(report)},JSON.stringify({namespace:service.typertRemote.namespace,serviceKey:service.typertRemote.serviceKey,bindingRevision:service.typertRemote.service.read().revision,revision:after.revision,before:before.value.sandboxDefaultAllow,after:after.value.sandboxDefaultAllow,effective:effective?.sandboxDefaultAllow,rows,metrics:service.metrics()}));
+}catch(error){writeFileSync(${JSON.stringify(report)},JSON.stringify({error:String(error)}));}});}`);
+  writeFileSync(join(profile,'cordis.patch.yml'),JSON.stringify([{insert:[{id:'hot-install-observer',name:observer}]}]));
+  const config=join(dir,'tsconfig.json');writeFileSync(config,JSON.stringify({compilerOptions:{paths:{'@deepseek-ai/dsh-app-boot':[join(repo,'.live-cli-build/packages/boot/app-boot/src/index.js')]}}}));
+  const env={PATH:`${resolve(process.execPath,'..')}:${process.env.DSH_LIVE_PATH??process.env.PATH}`,HOME:home,DSH_HOME:home,TSX_TSCONFIG_PATH:config,COREPACK_ENABLE_NETWORK:'0',DSH_TELEMETRY_DISABLED:'1',LANG:'C.UTF-8'};
+  const cache=process.env.DSH_LIVE_COREPACK_HOME??process.env.COREPACK_HOME;if(cache)env.COREPACK_HOME=cache;
+  let out='',err='';const web=spawn(process.execPath,['--import',tsx,bin,'--profile','web','--host','127.0.0.1','--port','0','--no-open'],{cwd:dir,env,stdio:['ignore','pipe','pipe']});
+  web.stdout.on('data',b=>{out+=b;writeFileSync(join(dir,'web.stdout.log'),out)});web.stderr.on('data',b=>{err+=b;writeFileSync(join(dir,'web.stderr.log'),err)});
+  const exited=new Promise(r=>web.once('exit',(code,signal)=>r({code,signal})));
+  try{
+    await until(()=>{if(web.exitCode!==null)throw Error(`web exited ${web.exitCode}`);return /dsh web: http:\/\/(?:127\.0\.0\.1|localhost):\d+/.test(out)});
+    const url=out.match(/dsh web: (http:\/\/(?:127\.0\.0\.1|localhost):\d+)/)[1];assert.equal((await fetch(url)).status,200);assert.equal(existsSync(report),false);
+    if(process.env.DSH_LIVE_BROWSER_GATES==='1'){
+      writeFileSync(join(dir,'before-install.json'),JSON.stringify({url,pid:web.pid,installGate:join(dir,'INSTALL'),finishGate:join(dir,'FINISH'),maxWaitMs:300000}));
+      console.log(`BEFORE_INSTALL=${dir} URL=${url}`);
+      await until(()=>existsSync(join(dir,'INSTALL')),300000);
+    }
+    const add=spawnSync(process.execPath,['--import',tsx,bin,'plugin','--profile','web','add',...files,'--offline','--ignore-scripts','--store-dir',join(dir,'store')],{cwd:dir,env,encoding:'utf8',timeout:45000});
+    writeFileSync(join(dir,'plugin-add.stdout.log'),add.stdout??'');writeFileSync(join(dir,'plugin-add.stderr.log'),add.stderr??'');assert.equal(add.status,0);
+    await until(()=>existsSync(report));const actual=JSON.parse(readFileSync(report,'utf8'));assert.equal(actual.error,undefined);assert.equal(actual.namespace,'actionReviewSettings');assert.equal(actual.serviceKey,'actionReviewSettings');assert.equal(actual.bindingRevision,actual.revision);assert.notEqual(actual.before,actual.after);assert.equal(actual.effective,actual.after);
+    assert.ok(actual.rows.some(r=>r.id==='auto-review-llm'&&r.protocol==='codex-native'));
+    for(const id of ['auto-review','auto-review-llm','auto-review-settings','auto-review-audit','auto-review-policy','auto-review-command'])assert.ok(actual.rows.some(r=>r.id===id),id);
+    writeFileSync(join(dir,'result.json'),JSON.stringify({status:'PASS',pid:web.pid,url,realCli:true,realPackage:plugin.pkg.name,version:plugin.pkg.version,settingsBinding:true,settingsMutation:true,nativeInvoked:false,browserTested:false}));console.log(`REAL_AUTO_REVIEW_EVIDENCE=${dir}`);
+    if(process.env.DSH_LIVE_BROWSER_GATES==='1')await until(()=>existsSync(join(dir,'FINISH')),300000);
+  }catch(error){writeFileSync(join(dir,'failure.txt'),String(error));throw error;}
+  finally{web.kill('SIGTERM');let timer;const state=await Promise.race([exited,new Promise(r=>{timer=setTimeout(()=>r(null),7000)})]);clearTimeout(timer);if(state===null){web.kill('SIGKILL');await exited;}writeFileSync(join(dir,'exit.json'),JSON.stringify(state));}
+});
