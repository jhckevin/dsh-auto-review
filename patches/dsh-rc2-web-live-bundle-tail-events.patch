@@ -8,6 +8,26 @@ import { boot, watchUserPatches, loadProfile } from '../../../packages/boot/app-
 import Hmr from '@deepseek-ai/cordis-plugin-hmr'
 import Timer from '@deepseek-ai/cordis-plugin-timer'
 
+test('dispose during composed settle delay does not apply the pending real file change', async () => {
+  const dir=mkdtempSync(join(tmpdir(),'dsh-watch-settle-'))
+  const root=join(dir,'cordis.yml'),user=join(dir,'user.yml')
+  writeFileSync(root,'[]');writeFileSync(user,'[]')
+  const ctx=await boot('dsh-test',root)
+  await ctx.plugin(Timer);await ctx.plugin(Hmr,{root:[],debounce:0,ignored:[]})
+  const hmr=ctx.get('hmr')!, original=hmr.registerConfig.bind(hmr)
+  let armed=false, observed=false, applies=0
+  hmr.registerConfig=async (path,refresh)=>original(path,()=>{if(armed)observed=true;return refresh()})
+  const dispose=await watchUserPatches(ctx,{binName:'dsh-test',filename:user,extraFilenames:()=>[],onApplied:()=>{applies++}})
+  try {
+    await new Promise(resolve=>setTimeout(resolve,120))
+    const before=applies;armed=true
+    writeFileSync(user,'[] # final change')
+    await until(()=>observed)
+    await dispose()
+    assert.equal(applies,before,'stopped watcher must not apply after settle delay')
+  } finally {await dispose();await ctx.fiber.dispose();rmSync(dir,{recursive:true,force:true})}
+})
+
 async function until(check: () => boolean): Promise<void> {
   const deadline = Date.now() + 8000
   while (!check()) { if (Date.now() > deadline) throw new Error('watcher did not settle'); await new Promise(resolve => setTimeout(resolve, 20)) }
diff --git a/packages/boot/app-boot/src/index.ts b/packages/boot/app-boot/src/index.ts
index f72630b5..a71a62d9 100644
--- a/packages/boot/app-boot/src/index.ts
+++ b/packages/boot/app-boot/src/index.ts
@@ -273,6 +273,11 @@ export async function watchUserPatches(
     }
     const enqueue = (): Promise<void> => {
       const task = tail.then(async () => {
+        if (stopped) return
+        // Chokidar 4.0.3 drops same-path changes within a fixed 50 ms window.
+        // Read after that window so its suppressed trailing write is included.
+        // Only the composed watch opts into this bounded settle delay.
+        await new Promise(resolve => setTimeout(resolve, 60))
         if (stopped) return
         await refresh()
         if (!stopped) await registerPaths()
