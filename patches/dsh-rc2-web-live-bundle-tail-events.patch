@@ -0,0 +1,57 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtempSync,mkdirSync,writeFileSync,readFileSync,existsSync,symlinkSync,readdirSync,realpathSync} from 'node:fs';
+import {createRequire} from 'node:module';
+import {resolve,join} from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {spawn,execFileSync} from 'node:child_process';
+const repo=fileURLToPath(new URL('../../../',import.meta.url));
+const sourceBin=join(repo,'.live-cli-build/apps/cli/src/bin.js');
+const tsx=fileURLToPath(import.meta.resolve('tsx/esm'));
+async function until(check,ms=30000){const end=Date.now()+ms;while(!check()){if(Date.now()>end)throw new Error('condition timed out');await new Promise(r=>setTimeout(r,25));}}
+test('actual CLI offline tgz installation reaches an already running patched web profile',{timeout:120000},async()=>{
+  const evidenceParent=process.env.DSH_LIVE_EVIDENCE_PARENT;
+  assert.ok(evidenceParent,'Set a private evidence parent directory');
+  const dir=mkdtempSync(join(evidenceParent,'cli-live-'));
+  // Reuse immutable installed peers through an ancestor, never let pnpm mutate them.
+  const peers=join(dir,'node_modules','@deepseek-ai');mkdirSync(peers,{recursive:true});
+  const require=createRequire(join(repo,'apps/cli/package.json'));
+  for(const bundle of ['@deepseek-ai/dsh-base','@deepseek-ai/dsh-web-app']){
+    const scope=resolve(realpathSync(require.resolve(`${bundle}/package.json`)),'../../..','@deepseek-ai');
+    for(const name of readdirSync(scope)){const dest=join(peers,name);if(!existsSync(dest))symlinkSync(realpathSync(join(scope,name)),dest,'dir');}
+  }
+  const home=join(dir,'home'),profile=join(home,'profiles','web'),fixture=join(dir,'fixture','package');
+  mkdirSync(profile,{recursive:true});mkdirSync(fixture,{recursive:true});
+  writeFileSync(join(profile,'package.json'),JSON.stringify({name:'private-web-smoke',private:true,packageManager:'pnpm@11.7.0',dsh:{profile:{bundles:['@deepseek-ai/dsh-base','@deepseek-ai/dsh-web-app']}}}));
+  writeFileSync(join(profile,'cordis.patch.yml'),'[]');
+  const config=join(dir,'tsconfig.json');
+  writeFileSync(config,JSON.stringify({compilerOptions:{target:'ES2024',module:'ESNext',moduleResolution:'bundler',paths:{'@deepseek-ai/dsh-app-boot':[join(repo,'.live-cli-build/packages/boot/app-boot/src/index.js')]}}}));
+  const marker=join(dir,'plugin-state.txt');
+  writeFileSync(join(fixture,'package.json'),JSON.stringify({name:'@test/live-bundle',version:'1.0.0',type:'module',exports:{'.':'./index.mjs','./package.json':'./package.json'},dsh:{bundle:{patch:'./cordis.patch.yml'}}}));
+  writeFileSync(join(fixture,'index.mjs'),`import {writeFileSync} from 'node:fs'; export function apply(ctx,c){writeFileSync(c.marker,'active');ctx.effect(()=>()=>writeFileSync(c.marker,'disposed'));}`);
+  writeFileSync(join(fixture,'cordis.patch.yml'),JSON.stringify([{insert:[{id:'test-live-bundle',name:'@test/live-bundle',config:{marker}}]}]));
+  const tgz=join(dir,'fixture.tgz');execFileSync('tar',['-czf',tgz,'-C',join(dir,'fixture'),'package']);
+  const env={PATH:`${resolve(process.execPath,'..')}:/home/jhckevin/.local/bin:/usr/bin:/bin`,HOME:home,DSH_HOME:home,TSX_TSCONFIG_PATH:config,COREPACK_HOME:'/home/jhckevin/.cache/node/corepack',COREPACK_ENABLE_NETWORK:'0',DSH_TELEMETRY_DISABLED:'1',LANG:'C.UTF-8'};
+  let out='',err='';
+  const web=spawn(process.execPath,['--import',tsx,sourceBin,'--profile','web','--host','127.0.0.1','--port','0','--no-open'],{cwd:dir,env,stdio:['ignore','pipe','pipe']});
+  web.stdout.on('data',b=>{out+=b;writeFileSync(join(dir,'web.stdout.log'),out)});web.stderr.on('data',b=>{err+=b;writeFileSync(join(dir,'web.stderr.log'),err)});
+  const exited=new Promise(r=>web.once('exit',(code,signal)=>r({code,signal})));
+  try{
+    await until(()=>{if(web.exitCode!==null)throw new Error(`web exited ${web.exitCode}; ${err.slice(-1200)}`);return /dsh web: http:\/\/(?:127\.0\.0\.1|localhost):\d+/.test(out)});
+    const url=out.match(/dsh web: (http:\/\/(?:127\.0\.0\.1|localhost):\d+)/)[1];
+    const response=await fetch(url);assert.equal(response.status,200);
+    const result=execFileSync(process.execPath,['--import',tsx,sourceBin,'plugin','--profile','web','add',tgz,'--offline','--ignore-scripts','--store-dir',join(dir,'store')],{cwd:dir,env,encoding:'utf8',timeout:45000});
+    writeFileSync(join(dir,'plugin-add.stdout.log'),result);
+    const installed=JSON.parse(readFileSync(join(profile,'package.json'),'utf8'));assert.ok(installed.dsh.profile.bundles.includes('@test/live-bundle'));
+    await until(()=>existsSync(marker)&&readFileSync(marker,'utf8')==='active');
+    for(let round=0;round<10;round++){
+      writeFileSync(join(profile,'cordis.patch.yml'),'- id: test-live-bundle\n  disabled: true\n');
+      await until(()=>readFileSync(marker,'utf8')==='disposed');
+      // Deliberately no sleep: final operator edits must survive native throttling.
+      writeFileSync(join(profile,'cordis.patch.yml'),'[]');await until(()=>readFileSync(marker,'utf8')==='active');
+    }
+    writeFileSync(join(dir,'result.json'),JSON.stringify({status:'PASS',sourceBin,pid:web.pid,url,realCli:true,packageManager:'pnpm offline add tgz',bundleInstalled:true,liveActivation:true,configDisableEnable:true,codeHmr:false},null,2));
+    console.log(`CLI_LIVE_EVIDENCE=${dir}`);
+  }catch(error){writeFileSync(join(dir,'failure.txt'),String(error));throw error;}
+  finally{web.kill('SIGTERM');const state=await Promise.race([exited,new Promise(r=>setTimeout(()=>r(null),7000))]);if(state===null){web.kill('SIGKILL');await exited;}writeFileSync(join(dir,'exit.json'),JSON.stringify(state));}
+});
