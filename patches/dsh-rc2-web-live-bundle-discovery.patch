index 00000000..b92190e5
--- /dev/null
+++ b/apps/cli/src/live-bundles.ts
@@ -0,0 +1,61 @@
+/** Additive web profile reconciliation; imported packages never undergo code HMR. */
+import { readFileSync, realpathSync } from 'node:fs'
+import { join } from 'node:path'
+import { createHash } from 'node:crypto'
+import type { Profile, ProfileLayer } from '@deepseek-ai/dsh-app-boot'
+
+function identity(layer: ProfileLayer): string {
+  return createHash('sha256').update(realpathSync(layer.packageDir))
+    .update(readFileSync(join(layer.packageDir, 'package.json'))).digest('hex')
+}
+
+/** Keeps the last accepted bundle roster when installed packages are removed or replaced. */
+export class LiveBundles {
+  private current: Profile
+  private readonly imported = new Map<string, string>()
+  private lastWarning = ''
+  private pending?: { profile: Profile; identities: Map<string, string> }
+
+  constructor(profile: Profile, private readonly warn: (message: string) => void,
+    private readonly loadedModules: () => ReadonlySet<string> = () => new Set()) {
+    this.current = profile
+    for (const layer of profile.layers) this.imported.set(layer.packageName, identity(layer))
+  }
+
+  /** Resolve additions without dropping already mounted protection when pnpm changes existing packages. */
+  prepare(load: () => Profile): Profile {
+    this.pending = undefined
+    const fresh = load()
+    const names = fresh.layers.map(layer => layer.packageName)
+    // Reordering can change config authority; it is not an additive installation.
+    const previous = this.current.layers.map(layer => layer.packageName)
+    const retained = names.filter(name => this.imported.has(name))
+    let reason = retained.join('\n') !== previous.join('\n') ? 'removed or reordered bundle' : ''
+    for (const layer of fresh.layers) {
+      const old = this.imported.get(layer.packageName)
+      if (old === undefined && this.loadedModules().has(layer.packageName)) reason = `already imported module ${layer.packageName}`
+      if (old !== undefined && old !== identity(layer)) reason = `changed imported bundle ${layer.packageName}`
+    }
+    if (reason) {
+      if (reason !== this.lastWarning) this.warn(`dsh: needs-restart: ${reason}; retaining active bundle configuration until restart`)
+      this.lastWarning = reason
+      return this.current
+    }
+    this.pending = {profile: fresh, identities: new Map(fresh.layers.map(layer => [layer.packageName, identity(layer)]))}
+    return fresh
+  }
+
+  /** Accept only the generation whose complete Include update has succeeded. */
+  commit(): void {
+    if (this.pending === undefined) return
+    for (const [name, hash] of this.pending.identities) this.imported.set(name, hash)
+    this.current = this.pending.profile
+    this.pending = undefined
+    this.lastWarning = ''
+  }
+
+  /** Exact config paths expand only as additive bundles are accepted. */
+  paths(): string[] {
+    return [join(this.current.dir, 'package.json'), ...this.current.layers.map(layer => layer.patchPath)]
+  }
+}
