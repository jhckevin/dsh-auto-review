@@ -0,0 +1,138 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { mkdtempSync, mkdirSync, writeFileSync, existsSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { LiveBundles } from '../src/live-bundles.ts'
+import { boot, watchUserPatches, loadProfile } from '../../../packages/boot/app-boot/src/index.ts'
+import Hmr from '@deepseek-ai/cordis-plugin-hmr'
+import Timer from '@deepseek-ai/cordis-plugin-timer'
+
+async function until(check: () => boolean): Promise<void> {
+  const deadline = Date.now() + 8000
+  while (!check()) { if (Date.now() > deadline) throw new Error('watcher did not settle'); await new Promise(resolve => setTimeout(resolve, 20)) }
+}
+
+test('additive bundle discovery preserves removed/replaced protection and watches newly introduced config', async () => {
+  const home = mkdtempSync(join(tmpdir(), 'dsh-live-bundles-'))
+  const dir = join(home, 'profiles', 'smoke'); mkdirSync(dir, {recursive:true})
+  const manifest = join(dir, 'package.json'), user = join(dir, 'cordis.patch.yml')
+  writeFileSync(manifest, '{}')
+  writeFileSync(user, '[]')
+  const root = join(dir, 'cordis.yml'); writeFileSync(root, '[]')
+  writeFileSync(join(dir, 'probe.mjs'), 'export function apply(ctx, config) { ctx.provide("liveProbe", config.value) }')
+  const warnings: string[] = []
+  const load = () => loadProfile('dsh-test', 'smoke', join(home,'package.json'), home, {userLayer:false})
+  const profile = load()
+  const live = new LiveBundles(profile, message => warnings.push(message))
+  const ctx = await boot('dsh-test', root)
+  await ctx.plugin(Timer)
+  await ctx.plugin(Hmr, {root: [], debounce: 0, ignored: []})
+  const failures: unknown[] = []
+  ctx.on('hmr/config-update-failed', (_file, error) => failures.push(error))
+  const dispose = await watchUserPatches(ctx, {binName: 'dsh-test', filename: user,
+    extraFilenames: () => live.paths(),
+    compose: patches => [...live.prepare(load).layers.flatMap(layer => layer.patches), ...patches],
+    onApplied: () => live.commit(),
+  })
+  try {
+    const pkg = join(dir, 'node_modules', 'test-bundle'); mkdirSync(pkg,{recursive:true})
+    writeFileSync(join(pkg, 'package.json'), '{"name":"test-bundle","version":"1","dsh":{"bundle":{"patch":"patch.json"}}}')
+    const patchPath = join(pkg, 'patch.json')
+    const row = {insert:[{id:'probe',name:'./probe.mjs',config:{value:'added'}}]}
+    writeFileSync(patchPath, JSON.stringify([row]))
+    writeFileSync(user, 'invalid: [')
+    await until(() => failures.length >= 1)
+    const beforeInstallFailures = failures.length
+    writeFileSync(manifest, '{"dsh":{"profile":{"bundles":["test-bundle"]}}}')
+    await until(() => failures.length > beforeInstallFailures)
+    assert.equal(ctx.get('liveProbe'), undefined)
+    assert.equal(live.paths().includes(patchPath), false)
+    live.prepare(load)
+    assert.equal(live.paths().includes(patchPath), false, 'preparing alone must not commit an unmounted bundle')
+    await new Promise(resolve => setTimeout(resolve, 100))
+    writeFileSync(user, '[]')
+    await until(() => ctx.get('liveProbe') === 'added')
+    await new Promise(resolve => setTimeout(resolve, 100))
+    writeFileSync(patchPath, JSON.stringify([{insert:[{...row.insert[0],config:{value:'config-updated'}}]}]))
+    await until(() => ctx.get('liveProbe') === 'config-updated')
+    await new Promise(resolve => setTimeout(resolve, 100))
+    const beforeBadYaml = failures.length
+    writeFileSync(user, 'invalid: [')
+    await until(() => failures.length > beforeBadYaml)
+    assert.equal(ctx.get('liveProbe'), 'config-updated')
+    await new Promise(resolve => setTimeout(resolve, 100))
+    writeFileSync(user, '- id: probe\n  disabled: true\n')
+    await until(() => ctx.get('liveProbe') === undefined)
+    await new Promise(resolve => setTimeout(resolve, 100))
+    writeFileSync(user, '[]')
+    await until(() => ctx.get('liveProbe') === 'config-updated')
+    writeFileSync(manifest, '{"dsh":{"profile":{"bundles":[]}}}')
+    await until(() => warnings.some(x => x.includes('removed')))
+    assert.equal(ctx.get('liveProbe'), 'config-updated')
+    await new Promise(resolve => setTimeout(resolve, 100))
+    writeFileSync(join(pkg, 'package.json'), '{"name":"test-bundle","version":"2","dsh":{"bundle":{"patch":"patch.json"}}}')
+    writeFileSync(manifest, '{"dsh":{"profile":{"bundles":["test-bundle"]}}}')
+    await until(() => warnings.some(x => x.includes('changed imported')))
+    assert.equal(ctx.get('liveProbe'), 'config-updated')
+    assert.equal(failures.length, beforeBadYaml + 1)
+    await dispose(); await dispose()
+    writeFileSync(user, '- id: probe\n  disabled: true\n')
+    await new Promise(resolve => setTimeout(resolve, 150))
+    assert.equal(ctx.get('liveProbe'), 'config-updated')
+  } finally {await dispose(); await ctx.fiber.dispose(); rmSync(home,{recursive:true,force:true})}
+})
+
+test('watch disposer waits for an in-flight Include refresh and removes extra file registrations', async () => {
+  const dir = mkdtempSync(join(tmpdir(), 'dsh-live-dispose-'))
+  const user=join(dir,'user.yml'), extra=join(dir,'manifest.json'), marker=join(dir,'disposing'), release=join(dir,'release')
+  writeFileSync(user,'[]'); writeFileSync(extra,'{}')
+  const root=join(dir,'cordis.yml')
+  writeFileSync(root, '- id: slow\n  name: ./slow.mjs\n  config:\n    value: initial\n')
+  writeFileSync(join(dir,'slow.mjs'), `import {writeFileSync,existsSync} from 'node:fs';
+export function apply(ctx,config) {ctx.provide('slowValue',config.value);ctx.effect(()=>async()=>{writeFileSync(${JSON.stringify(marker)},'1');const end=Date.now()+3000;while(!existsSync(${JSON.stringify(release)})){if(Date.now()>end)throw new Error('release timeout');await new Promise(r=>setTimeout(r,10));}});}`)
+  const ctx=await boot('dsh-test',root)
+  await ctx.plugin(Timer); await ctx.plugin(Hmr,{root:[],debounce:0,ignored:[]})
+  const dispose=await watchUserPatches(ctx,{binName:'dsh-test',filename:user,extraFilenames:()=>[extra]})
+  try {
+    writeFileSync(user,'- id: slow\n  config:\n    value: changed\n')
+    await until(()=>existsSync(marker))
+    let settled=false
+    const stopping=dispose().then(()=>{settled=true})
+    await new Promise(resolve=>setTimeout(resolve,40))
+    assert.equal(settled,false,'teardown must drain active refresh')
+    writeFileSync(release,'1'); await stopping
+    const value=ctx.get('slowValue')
+    writeFileSync(user,'- id: slow\n  config:\n    value: forbidden-late-update\n')
+    writeFileSync(extra,'{"late":true}')
+    await new Promise(resolve=>setTimeout(resolve,150))
+    assert.equal(ctx.get('slowValue'),value)
+    await dispose()
