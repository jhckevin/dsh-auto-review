@@ -31,7 +31,12 @@ test('actual CLI offline tgz installation reaches an already running patched web
   writeFileSync(join(fixture,'index.mjs'),`import {writeFileSync} from 'node:fs'; export function apply(ctx,c){writeFileSync(c.marker,'active');ctx.effect(()=>()=>writeFileSync(c.marker,'disposed'));}`);
   writeFileSync(join(fixture,'cordis.patch.yml'),JSON.stringify([{insert:[{id:'test-live-bundle',name:'@test/live-bundle',config:{marker}}]}]));
   const tgz=join(dir,'fixture.tgz');execFileSync('tar',['-czf',tgz,'-C',join(dir,'fixture'),'package']);
-  const env={PATH:`${resolve(process.execPath,'..')}:/home/jhckevin/.local/bin:/usr/bin:/bin`,HOME:home,DSH_HOME:home,TSX_TSCONFIG_PATH:config,COREPACK_HOME:'/home/jhckevin/.cache/node/corepack',COREPACK_ENABLE_NETWORK:'0',DSH_TELEMETRY_DISABLED:'1',LANG:'C.UTF-8'};
+  // Only explicit executable search/cache settings cross into the isolated child.
+  const inheritedPath=process.env.DSH_LIVE_PATH??process.env.PATH;
+  assert.ok(inheritedPath,'Provide PATH or DSH_LIVE_PATH containing offline pnpm');
+  const env={PATH:`${resolve(process.execPath,'..')}:${inheritedPath}`,HOME:home,DSH_HOME:home,TSX_TSCONFIG_PATH:config,COREPACK_ENABLE_NETWORK:'0',DSH_TELEMETRY_DISABLED:'1',LANG:'C.UTF-8'};
+  const corepackHome=process.env.DSH_LIVE_COREPACK_HOME??process.env.COREPACK_HOME;
+  if(corepackHome)env.COREPACK_HOME=corepackHome;
   let out='',err='';
   const web=spawn(process.execPath,['--import',tsx,sourceBin,'--profile','web','--host','127.0.0.1','--port','0','--no-open'],{cwd:dir,env,stdio:['ignore','pipe','pipe']});
   web.stdout.on('data',b=>{out+=b;writeFileSync(join(dir,'web.stdout.log'),out)});web.stderr.on('data',b=>{err+=b;writeFileSync(join(dir,'web.stderr.log'),err)});
