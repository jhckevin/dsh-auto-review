+import { createGraphEvents } from '../src/graph-events.ts'
+
+const row = (id: string): WebBootEntry => ({id,rev:'abcdef012345',url:`/plugins/${id}/client.js?rev=abcdef012345`,external:[]})
+const graph = (...entries: WebBootEntry[]) => ({rev:'123456abcdef',entries})
+const base = row('bootstrap')
+
+test('native Loader admission owns only added rows and removes them on consumer disposal',async()=>{
+  const m=system();m.admitGraph(graph(base,row('new')))
+  const ctx=new Context();await ctx.plugin(Loader);ctx.loader.internal=m as never
+  const oldId=await ctx.loader.create({name:'bootstrap'}),old=ctx.loader.resolve(oldId).fiber
+  const errors:unknown[]=[];const admission=createLoaderAdmission(ctx,e=>errors.push(e))
+  try {await m.prefetch('new');await admission.create('new',new AbortController().signal);assert.equal(ctx.get('live-new'),true);await admission.dispose();assert.equal(ctx.get('live-new'),undefined);assert.equal(ctx.loader.resolve(oldId).fiber,old);assert.equal(errors.length,0)}
+  finally{await admission.dispose();await ctx.fiber.dispose()}
+})
+
+test('consumer disposal cancels an unresolved create without waiting forever',async()=>{
+  let called=false
+  const c=createAdditiveConsumer({modules:system(),create:async()=>{called=true;await new Promise(()=>{})},report:()=>{}})
+  c.push(JSON.stringify(graph(base,row('new'))));await until(()=>called)
+  await Promise.race([c.dispose(),new Promise((_,reject)=>setTimeout(()=>reject(Error('dispose hung')),200))])
+})
+
+test('cancel a real in-flight apply, drain cooperative cleanup and prevent late service registration',async()=>{
+  const target={mode:'queue',pendingQueue:[],load(){}} as unknown as ClientModuleLoaderTarget
+  const gate=Promise.withResolvers<void>();let entered=false
+  const m=new ClientModuleSystem({manifest:parseBootManifest(graph(base)),staticModules:{},registrationTarget:target,bootstrapModule:{id:'bootstrap',exports:{apply(){}}},loadBundle:async()=>{target.load({id:'slow',factory:()=>({async apply(ctx: Context){entered=true;await gate.promise;ctx.provide('late-live-service',true)}})})}})
+  const ctx=new Context();await ctx.plugin(Loader);ctx.loader.internal=m as never
+  const errors:unknown[]=[];const admission=createLoaderAdmission(ctx,e=>errors.push(e))
+  const consumer=createAdditiveConsumer({modules:m,create:admission.create,report:e=>errors.push(e)})
+  try {
+    consumer.push(JSON.stringify(graph(base,row('slow'))));await until(()=>entered)
+    await consumer.dispose();const closing=admission.dispose()
+    gate.resolve();await closing
+    await until(()=>![...ctx.loader.entries()].some(entry=>entry.options.name==='slow'))
+    assert.equal(ctx.get('late-live-service'),undefined)
+  } finally {gate.resolve();await consumer.dispose();await admission.dispose();await ctx.fiber.dispose()}
+})
+
+test('bootstrap outside initial graph is reserved and failed factory cannot replay via new dependency',async()=>{
+  const target={mode:'queue',pendingQueue:[],load(){}} as unknown as ClientModuleLoaderTarget
+  let effects=0
+  const m=new ClientModuleSystem({manifest:parseBootManifest(graph()),staticModules:{},registrationTarget:target,bootstrapModule:{id:'bootstrap',exports:{}},loadBundle:async url=>{const id=url.slice('/plugins/'.length).split('/client.js?')[0]!;target.load({id,factory:require=>{if(id==='a'){effects++;throw Error('factory failed')}return {dependency:require('a')}}})}})
+  assert.throws(()=>m.admitGraph(graph(base)))
+  m.admitGraph(graph(row('a')));await assert.rejects(m.import('a'));assert.equal(effects,1)
+  m.admitGraph(graph(row('a'),{...row('b'),external:['a']}));await assert.rejects(m.import('b'));assert.equal(effects,1)
+})
+function system(load?: (id: string) => Promise<void>) {
+  const target = {mode:'queue',pendingQueue:[],load(){}} as unknown as ClientModuleLoaderTarget
+  const modules = new ClientModuleSystem({manifest:parseBootManifest(graph(base)),staticModules:{react:{}},registrationTarget:target,bootstrapModule:{id:base.id,exports:{apply(){}}},loadBundle:async url=>{
+    const id=url.slice('/plugins/'.length).split('/client.js?')[0]!
+    await load?.(id)
+    target.load({id,factory:()=>({apply(ctx: Context){ctx.provide(`live-${id}`,true)}})})
+  }})
+  return modules
+}
+async function until(fn:()=>boolean){const end=Date.now()+3000;while(!fn()){if(Date.now()>end)throw Error('timeout');await new Promise(r=>setTimeout(r,5));}}
+
+test('strict wire preserves original modules and permits recovery after rejected snapshots',()=>{
+  const m=system(), before=m.manifest
+  const cases: unknown[]=[graph(),graph({...base,rev:'ffffffffffff'}),graph({...base,inject:['changed']}),graph(base,base),graph(base,row('react')),graph(base,row('bad/client')),graph(base,{...row('new'),url:'https://evil.invalid/x'}),graph(base,{...row('new'),extra:1}),{...graph(base),extra:1},graph(base,{...row('new'),external:['missing']}),graph(base,{...row('a'),external:['b']},{...row('b'),external:['a']})]
+  for(const value of cases){assert.throws(()=>m.admitGraph(value));assert.deepEqual(m.manifest,before)}
+  const wire=graph(base,row('new'));m.admitGraph(wire);wire.entries[1]!.url='https://evil.invalid/'
+  const projection=m.manifest;projection.modules[1]!.url='bad'
+  assert.equal(m.manifest.modules[1]!.url,row('new').url)
+  assert.throws(()=>m.admitGraph(graph({...base,url:'/bad'},row('new'))))
+  assert.equal(m.admitGraph(graph(base,row('new'),row('next'))).modules.length,3)
+})
+
+test('prefetch failure retries same snapshot; real Loader creates new fiber once and preserves old fiber',async()=>{
+  let tries=0
+  const m=system(async()=>{if(++tries===1)throw Error('temporary transport')})
+  const ctx=new Context();await ctx.plugin(Loader);ctx.loader.internal=m as never
+  const oldId=await ctx.loader.create({name:'bootstrap'}),old=ctx.loader.resolve(oldId).fiber
+  const created:string[]=[],errors:unknown[]=[]
+  const consumer=createAdditiveConsumer({modules:m,report:e=>errors.push(e),create:async name=>{const id=await ctx.loader.create({name});await ctx.loader.resolve(id).fiber?.inertia;assert.equal(ctx.loader.resolve(id).fiber?.state,2);created.push(name)}})
+  try{
+    const data=JSON.stringify(graph(base,row('new')))
+    consumer.push(data);await until(()=>errors.length===1);assert.equal(created.length,0)
+    consumer.push(data);await until(()=>created.length===1);consumer.push(data);consumer.push(JSON.stringify(graph(base,row('new'),row('second'))));await until(()=>created.length===2)
+    assert.deepEqual(created,['new','second']);assert.equal(ctx.loader.resolve(oldId).fiber,old);assert.equal(ctx.get('live-new'),true)
+  }finally{await consumer.dispose();await ctx.fiber.dispose()}
+})
+
+test('dispose during prefetch never creates late fiber',async()=>{
+  const gate=Promise.withResolvers<void>();let entered=false,created=0
+  const m=system(async()=>{entered=true;await gate.promise})
+  const c=createAdditiveConsumer({modules:m,create:async()=>{created++},report:()=>{}})
+  c.push(JSON.stringify(graph(base,row('new'))));await until(()=>entered);await c.dispose();gate.resolve();await new Promise(r=>setTimeout(r,10));assert.equal(created,0)
+  c.push(JSON.stringify(graph(base,row('new'))));assert.equal(created,0)
+})
+
+test('invalid snapshot followed synchronously by good snapshot does not lose tail; apply failure is not replayed',async()=>{
+  let calls=0;const errors:unknown[]=[]
+  const c=createAdditiveConsumer({modules:system(),create:async()=>{calls++;throw Error('apply failed')},report:e=>errors.push(e)})
+  c.push('{}');c.push(JSON.stringify(graph(base,row('new'))));await until(()=>calls===1)
+  c.push(JSON.stringify(graph(base,row('new'))));await new Promise(r=>setTimeout(r,20));assert.equal(calls,1);assert.ok(errors.length>=2);await c.dispose()
+})
+
+test('real HTTP SSE publishes new snapshots, reconnects to latest and closes on dispose',async()=>{
+  let current=graph(base);const listeners=new Set<()=>void>()
+  const events=createGraphEvents({graph:()=>current,onGraphChanged:fn=>{listeners.add(fn);return()=>listeners.delete(fn)}})
+  const server=createServer(events.handle);await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));const address=server.address();assert.ok(address&&typeof address!=='string');const url=`http://127.0.0.1:${address.port}`
+  const abort=new AbortController()
+  try{
+    assert.equal((await fetch(url,{method:'POST'})).status,405)
+    const response=await fetch(url,{signal:abort.signal});const reader=response.body!.getReader()
+    assert.match(new TextDecoder().decode((await reader.read()).value),/bootstrap/)
+    current=graph(base,row('new'));for(const listener of listeners)listener()
+    assert.match(new TextDecoder().decode((await reader.read()).value),/new/);await reader.cancel()
+    current=graph(base,row('new'),row('latest'))
+    const reconnected=await fetch(url,{signal:abort.signal});const second=reconnected.body!.getReader();assert.match(new TextDecoder().decode((await second.read()).value),/latest/)
+    events.dispose();assert.equal((await second.read()).done,true);assert.equal(listeners.size,0)
+  }finally{abort.abort();events.dispose();server.closeAllConnections();await new Promise<void>(r=>server.close(()=>r()))}
+})
