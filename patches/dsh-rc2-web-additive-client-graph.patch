index 00000000..84517bc8
--- /dev/null
+++ b/packages/client/modules/src/client/loader-admission.ts
@@ -0,0 +1,54 @@
+/** Own only entries created by this metadata consumer, never bootstrap entries. */
+import type { Context } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/cordis-plugin-loader'
+
+export function createLoaderAdmission(ctx: Context, report: (error: unknown) => void): {
+  create(name: string, signal: AbortSignal): Promise<void>
+  dispose(): Promise<void>
+} {
+  const owned = new Set<string>()
+  const removals = new Set<Promise<void>>()
+  let stopped = false
+  const remove = (id: string): Promise<void> => {
+    if (!owned.delete(id)) return Promise.resolve()
+    const entry = [...ctx.loader.entries()].find(value => value.id === id)
+    const task = (entry === undefined ? Promise.resolve() : entry.parent.remove(entry.options.id))
+      .finally(() => { removals.delete(task) })
+    removals.add(task)
+    return task
+  }
+  return {
+    async create(name, signal) {
+      signal.throwIfAborted()
+      if (stopped) throw new Error('client graph: entry owner stopped')
+      const before = new Set([...ctx.loader.entries()].map(entry => entry.id))
+      const task = ctx.loader.create({ name })
+      // Loader publishes its Entry before its async import/apply. Capture that
+      // exact new ID before yielding; cancellation can then remove a pending row.
+      const additions = [...ctx.loader.entries()].filter(entry => !before.has(entry.id) && entry.options.name === name)
+      for (const entry of additions) owned.add(entry.id)
+      const cancel = (): void => { for (const entry of additions) void remove(entry.id).catch(report) }
+      signal.addEventListener('abort', cancel, { once: true })
+      try {
+        const id = await task
+        if (signal.aborted || stopped) { if (!owned.has(id)) owned.add(id); await remove(id); return }
+        owned.add(id)
+        const entry = ctx.loader.resolve(id)
+        await entry.fiber?.inertia
+        if (signal.aborted || stopped) { await remove(id); return }
+        // Cordis 4 FiberState.ACTIVE is 2; factory errors are never replayed.
+        if (entry.fiber?.state !== 2) throw new Error(`client graph: needs-restart inactive plugin ${name}`)
+      } finally { signal.removeEventListener('abort', cancel) }
+    },
+    async dispose() {
+      stopped = true
+      for (const id of [...owned]) void remove(id).catch(report)
+      let timer: ReturnType<typeof setTimeout> | undefined
+      try {
+        await Promise.race([Promise.all([...removals].map(task => task.catch(report))), new Promise<void>(resolve => {
+          timer = setTimeout(() => { report(new Error('client graph: needs-restart uncooperative plugin disposal')); resolve() }, 5000)
+        })])
+      } finally { clearTimeout(timer) }
+    },
+  }
+}
