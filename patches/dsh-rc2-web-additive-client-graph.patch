diff --git a/packages/client/modules/src/client/live-graph.ts b/packages/client/modules/src/client/live-graph.ts
new file mode 100644
index 00000000..a2a57faf
--- /dev/null
+++ b/packages/client/modules/src/client/live-graph.ts
@@ -0,0 +1,56 @@
+/** One bounded metadata consumer; never invalidates code or existing fibers. */
+import type { ClientModuleLoader } from './manifest.ts'
+export function createAdditiveConsumer(options: {
+  modules: ClientModuleLoader
+  create(id: string, signal: AbortSignal): Promise<void>
+  report(error: unknown): void
+}): { push(data: string): void, dispose(): Promise<void> } {
+  const abort = new AbortController()
+  const attempted = new Set(options.modules.manifest.plugins.map(row => row.id))
+  let latest: string | undefined, running: Promise<void> | undefined
+  const bounded = async <T>(start: (signal: AbortSignal) => Promise<T>): Promise<T> => {
+    const deadline = new AbortController()
+    const signal = AbortSignal.any([abort.signal, deadline.signal])
+    signal.throwIfAborted()
+    let timer: ReturnType<typeof setTimeout> | undefined
+    let rejectAbort: () => void = () => {}
+    try {
+      return await Promise.race([start(signal), new Promise<never>((_, reject) => {
+        rejectAbort = () => reject(signal.reason)
+        signal.addEventListener('abort', rejectAbort, { once: true })
+        timer = setTimeout(() => deadline.abort(new Error('client graph: operation timed out')), 30000)
+      })])
+    } finally { clearTimeout(timer); signal.removeEventListener('abort', rejectAbort) }
+  }
+  const drain = async (): Promise<void> => {
+    while (latest !== undefined && !abort.signal.aborted) {
+      const data = latest; latest = undefined
+      try {
+        const manifest = options.modules.admitGraph(JSON.parse(data))
+        for (const row of manifest.plugins) {
+          if (attempted.has(row.id)) continue
+          await bounded(() => options.modules.prefetch(row.id))
+          abort.signal.throwIfAborted()
+          // Never replay a factory/apply after create begins. A transport-only
+          // failure above remains retryable on the next full snapshot.
+          attempted.add(row.id)
+          await bounded(signal => options.create(row.id, signal))
+          abort.signal.throwIfAborted()
+        }
+      } catch (error) { if (!abort.signal.aborted) options.report(error) }
+    }
+  }
+  const kick = (): void => {
+    if (running !== undefined || abort.signal.aborted || latest === undefined) return
+    running = drain().finally(() => { running = undefined; kick() })
+  }
+  return {
+    push(data) {
+      if (abort.signal.aborted) return
+      if (data.length > 2097152) { options.report(new Error('client graph: frame too large')); return }
+      latest = data
+      kick()
+    },
+    async dispose() { latest = undefined; abort.abort(new Error('client graph: disposed')); await running },
+  }
+}
diff --git a/packages/client/modules/src/client/loader-admission.ts b/packages/client/modules/src/client/loader-admission.ts
