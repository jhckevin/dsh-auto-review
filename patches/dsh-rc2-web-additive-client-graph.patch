diff --git a/packages/client/modules/src/graph-events.ts b/packages/client/modules/src/graph-events.ts
new file mode 100644
index 00000000..cdf88848
--- /dev/null
+++ b/packages/client/modules/src/graph-events.ts
@@ -0,0 +1,36 @@
+/** Production metadata subscription: no file polling or source-code HMR. */
+import type { IncomingMessage, ServerResponse } from 'node:http'
+import type { WebBootGraph } from './client/manifest.ts'
+
+export function createGraphEvents(source: { graph(): WebBootGraph, onGraphChanged(fn: () => void): () => void }): {
+  handle(req: IncomingMessage, res: ServerResponse): void
+  dispose(): void
+} {
+  const clients = new Set<ServerResponse>()
+  let stopped = false
+  const send = (res: ServerResponse): void => {
+    if (res.destroyed || res.writableLength > 1048576) { clients.delete(res); res.destroy(); return }
+    const body = JSON.stringify(source.graph())
+    if (body.length > 2097152) { clients.delete(res); res.end(); return }
+    res.write(`data: ${body}\n\n`)
+  }
+  const unsubscribe = source.onGraphChanged(() => { for (const res of clients) send(res) })
+  return {
+    handle(req, res) {
+      if (req.method !== 'GET') { res.writeHead(405); res.end(); return }
+      if (stopped || clients.size >= 32) { res.writeHead(503); res.end(); return }
+      res.writeHead(200, { 'Content-Type': 'text/event-stream', 'Cache-Control': 'no-cache', 'X-Accel-Buffering': 'no' })
+      clients.add(res)
+      res.on('close', () => { clients.delete(res) })
+      // Register first, then read the newest full snapshot: reconnect cannot
+      // miss an addition between subscription and initial publication.
+      send(res)
+    },
+    dispose() {
+      if (stopped) return
+      stopped = true; unsubscribe()
+      for (const res of clients) res.end()
+      clients.clear()
+    },
+  }
+}
